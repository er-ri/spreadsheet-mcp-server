{
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "grep -oP '\"file_path\"\\s*:\\s*\"\\K[^\"]*' | { read -r f; [[ \"$f\" == *.cs ]] && dotnet csharpier format \"$f\"; } 2>/dev/null || true",
            "statusMessage": "Formatting with CSharpier..."
          }
        ]
      }
    ]
  }
}
