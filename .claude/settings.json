{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [],
    "deny": ["Bash(git push *)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "grep -oP '\"file_path\"\\s*:\\s*\"\\K[^\"]*' | { read -r f; case \"$f\" in *.cs) dotnet csharpier format \"$f\" ;; esac; } || true",
            "statusMessage": "Formatting with CSharpier..."
          }
        ]
      }
    ]
  },
  "autoMode": {
    "environment": ["$defaults", "Source control: github.com/er-ri/spreadsheet-mcp-server.git"]
  },
  "env": {
    "CLAUDE_CODE_ENABLE_AUTO_MODE": "1"
  }
}
